+#ifndef SDL_switchvideo_h_
+#define SDL_switchvideo_h_
+
+#include "SDL_internal.h"
+#include "../SDL_sysvideo.h"
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+
+// Per-device state: a single EGL context bound to the Switch default NWindow.
+struct SDL_VideoData
+{
+    bool egl_initialized;
+    EGLDisplay display;
+    EGLContext context;
+    EGLSurface surface;
+    EGLConfig config;
+    int swap_interval;
+};
+
+struct SDL_WindowData
+{
+    bool uses_gl;
+};
+
+#endif // SDL_switchvideo_h_