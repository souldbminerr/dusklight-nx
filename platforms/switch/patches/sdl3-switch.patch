--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1771,7 +1771,7 @@ elseif(EMSCRIPTEN)
   CheckPTHREAD()
   CheckLibUnwind()
 
-elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
+elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU AND NOT SWITCH)
 
   set(SDL_DISABLE_DLOPEN_NOTES TRUE)
   if(SDL_DLOPEN_NOTES)
@@ -3315,6 +3315,71 @@ elseif(N3DS)
     "${SDL3_SOURCE_DIR}/src/io/n3ds/*.h"
   )
 
+elseif(SWITCH)
+  # Nintendo Switch homebrew (libnx / devkitPro). Private fork backend.
+  # The devkitA64 toolchain does not predefine __SWITCH__, so add it here.
+  sdl_compile_definitions(PUBLIC "__SWITCH__")
+
+  # Threads: libnx provides POSIX pthreads.
+  set(SDL_THREAD_PTHREAD 1)
+  set(SDL_THREAD_PTHREAD_RECURSIVE_MUTEX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/thread/pthread/*.c")
+  set(HAVE_SDL_THREADS TRUE)
+
+  set(SDL_TIMER_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/timer/unix/*.c")
+  set(HAVE_SDL_TIMERS TRUE)
+
+  set(SDL_TIME_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/time/unix/*.c")
+  set(HAVE_SDL_TIME TRUE)
+
+  set(SDL_FILESYSTEM_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/filesystem/unix/*.c")
+  set(HAVE_SDL_FILESYSTEM TRUE)
+
+  set(SDL_FSOPS_POSIX 1)
+  sdl_sources("${SDL3_SOURCE_DIR}/src/filesystem/posix/SDL_sysfsops.c")
+  set(HAVE_SDL_FSOPS TRUE)
+
+  set(SDL_STORAGE_GENERIC 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/storage/generic/*.c")
+  set(HAVE_SDL_STORAGE 1)
+
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/locale/unix/*.c")
+  set(HAVE_SDL_LOCALE TRUE)
+
+  if(SDL_AUDIO)
+    set(SDL_AUDIO_DRIVER_SWITCH 1)
+    sdl_glob_sources(
+      "${SDL3_SOURCE_DIR}/src/audio/switch/*.c"
+      "${SDL3_SOURCE_DIR}/src/audio/switch/*.h"
+    )
+    set(HAVE_SDL_AUDIO TRUE)
+  endif()
+
+  if(SDL_JOYSTICK)
+    set(SDL_JOYSTICK_SWITCH 1)
+    sdl_glob_sources("${SDL3_SOURCE_DIR}/src/joystick/switch/*.c")
+    set(HAVE_SDL_JOYSTICK TRUE)
+  endif()
+
+  if(SDL_VIDEO)
+    set(SDL_VIDEO_DRIVER_SWITCH 1)
+    set(SDL_VIDEO_OPENGL_ES2 1)
+    set(SDL_VIDEO_RENDER_OGL_ES2 1)
+    sdl_glob_sources(
+      "${SDL3_SOURCE_DIR}/src/video/switch/*.c"
+      "${SDL3_SOURCE_DIR}/src/video/switch/*.h"
+    )
+    # switch-mesa's EGL/GLES headers live in the portlibs prefix.
+    sdl_include_directories(PRIVATE SYSTEM "$ENV{DEVKITPRO}/portlibs/switch/include")
+    set(HAVE_SDL_VIDEO TRUE)
+  endif()
+
+  # audio / joystick / sensor / power / haptic fall back to dummy/disabled here;
+  # later phases add AUDOUT audio and HID input.
+
 elseif(NGAGE)
 
   enable_language(CXX)
@@ -3417,7 +3482,7 @@ if (SDL_DIALOG)
   if(ANDROID)
     sdl_sources(${SDL3_SOURCE_DIR}/src/dialog/android/SDL_androiddialog.c)
     set(HAVE_SDL_DIALOG TRUE)
-  elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
+  elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU AND NOT SWITCH)
     sdl_sources(${SDL3_SOURCE_DIR}/src/dialog/unix/SDL_unixdialog.c)
     sdl_sources(${SDL3_SOURCE_DIR}/src/dialog/unix/SDL_portaldialog.c)
     sdl_sources(${SDL3_SOURCE_DIR}/src/dialog/unix/SDL_portaldialog.h)
